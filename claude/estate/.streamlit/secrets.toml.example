# Copy to .streamlit/secrets.toml and fill in.  NEVER commit the real file.
#
# Generate the cookie secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

[auth]
redirect_uri = "http://localhost:8512/oauth2callback"
cookie_secret = "REPLACE-WITH-A-LONG-RANDOM-STRING"

[auth.google]
client_id = "xxxxxxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxxxxxxxxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Who may sign in.  Heirs are normally listed by putting their address in the
# `email` field against their name in config.json; anyone extra goes here.
[access]
allowed_emails = ["heir1@gmail.com", "heir2@gmail.com"]
# Admins can publish their configuration as the shared baseline and see the
# list of saved workspaces.
admins = ["heir1@gmail.com"]
